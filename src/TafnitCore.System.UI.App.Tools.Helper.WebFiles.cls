/// Generated by tools\build-webfiles.ps1 - do not edit by hand.
/// The web files of the remote-help solution, embedded as base64 (exact bytes).
/// Deploy(path) writes them under the CSP folder of /xtafnit (called by install^core.TafnitHelperUtils).
Class TafnitCore.System.UI.App.Tools.Helper.WebFiles [ Abstract ]
{

/// Writes every embedded file under pPath (the CSP folder). pLog(n) = one line per file.
ClassMethod Deploy(pPath As %String, Output pLog) As %Status
{
    set tSC=$$$OK, pLog=0, pPath=##class(%File).NormalizeDirectory(pPath)
    for tName="XtafnitRhJs","HelperHtml" {
        set tXData=##class(%Dictionary.CompiledXData).%OpenId(..%ClassName(1)_"||"_tName)
        if '$ISOBJECT(tXData) { set tSC=$$$ERROR($$$GeneralError,"XData "_tName_" missing") quit }
        set tText="" do tXData.Data.Rewind()
        while 'tXData.Data.AtEnd { set tText=tText_tXData.Data.Read(32000) }
        set tTarget=$PIECE($PIECE(tText,"target=""",2),"""",1)
        set tB64=$TRANSLATE($PIECE($PIECE(tText,">",2),"<",1),$CHAR(9,10,13,32))
        set tFile=pPath_tTarget
        do ##class(%File).CreateDirectoryChain(##class(%File).GetDirectory(tFile))
        set tOut=##class(%Stream.FileBinary).%New()
        set tSC=tOut.LinkToFile(tFile) quit:$$$ISERR(tSC)
        do tOut.Write($SYSTEM.Encryption.Base64Decode(tB64))
        set tSC=tOut.%Save() quit:$$$ISERR(tSC)
        set pLog=pLog+1, pLog(pLog)=tFile
    }
    quit tSC
}

/// Writes and compiles the routine core.TafnitHelperUtils from XData RoutineMac.
/// Used by Install when $SYSTEM.OBJ.LoadDir did not load the .mac file (or an older version is present).
ClassMethod DeployRoutine() As %Status
{
    set tXData=##class(%Dictionary.CompiledXData).%OpenId(..%ClassName(1)_"||RoutineMac")
    if '$ISOBJECT(tXData) quit $$$ERROR($$$GeneralError,"XData RoutineMac missing")
    set tText="" do tXData.Data.Rewind()
    while 'tXData.Data.AtEnd { set tText=tText_tXData.Data.Read(32000) }
    set tSource=$ZCONVERT($SYSTEM.Encryption.Base64Decode($TRANSLATE($PIECE($PIECE(tText,">",2),"<",1),$CHAR(9,10,13,32))),"I","UTF8")
    set tSource=$TRANSLATE(tSource,$CHAR(13))
    set tRoutine=##class(%Routine).%New("core.TafnitHelperUtils.MAC")
    do tRoutine.Clear()
    for i=1:1:$LENGTH(tSource,$CHAR(10)) {
        set tLine=$PIECE(tSource,$CHAR(10),i)
        continue:(i=1)&&($EXTRACT(tLine,1,8)="ROUTINE ")
        continue:(i=$LENGTH(tSource,$CHAR(10)))&&(tLine="")
        do tRoutine.WriteLine(tLine)
    }
    set tSC=tRoutine.Save() quit:$$$ISERR(tSC) tSC
    quit tRoutine.Compile("-d")
}

